PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/athlofit

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=30d
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production
JWT_REFRESH_EXPIRES_IN=90d

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Athlofit <noreply@athlofit.com>"

# Google OAuth (get from Google Cloud Console > APIs & Services > Credentials)
GOOGLE_WEB_CLIENT_ID=""
# GOOGLE_ANDROID_CLIENT_ID=248456486264-k51vt7it0ttahuemhs30c4uhe21oksrp.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=""


# Client URL (comma-separated for multiple origins: app, admin panel, website)
CLIENT_URL=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Gamification step-goal values are managed dynamically via AppConfig
# (GET /config/app → steps.defaultDailyGoal, coin_config.rewards.daily_step_goal_reached).
# Edit them from the admin panel, not here.

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# GOOGLE FIREBASE
CLIENT_EMAIL=""
PRIVATE_KEY=""
PROJECT_ID=""


# MSG91 (Phone OTP)
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_TEMPLATE_ID=your_msg91_otp_template_id_here
# Fast2SMS (Phone OTP)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Razorpay (Online Payments)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# AWS S3 (Admin image uploads)
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="athlofit-uploads"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Optional: CDN/custom domain serving the bucket (no trailing slash).
# If unset, falls back to https://<bucket>.s3.<region>.amazonaws.com
AWS_S3_PUBLIC_URL=""
