PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/athlofit

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=30d
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production
JWT_REFRESH_EXPIRES_IN=90d

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Athlofit <noreply@athlofit.com>"

# Google OAuth (get from Google Cloud Console > APIs & Services > Credentials)
GOOGLE_WEB_CLIENT_ID=""
# GOOGLE_ANDROID_CLIENT_ID=248456486264-k51vt7it0ttahuemhs30c4uhe21oksrp.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=""


# Client URL
CLIENT_URL=http://localhost:3000

# Gamification
DAILY_STEP_GOAL=10000
COINS_PER_STEP_GOAL=50
COINS_PER_PARTIAL_GOAL=10

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# GOOGLE FIREBASE
CLIENT_EMAIL=""
PRIVATE_KEY=""
PROJECT_ID=""


# Fast2SMS (Phone OTP)
FAST2SMS_API_KEY=your_fast2sms_api_key_here
